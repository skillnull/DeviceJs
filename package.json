{
  "name": "@skillnull/device-js",
  "version": "3.0.2",
  "description": "Get device information by javascript.",
  "main": "./dist/device.js",
  "module": "./dist/device.mjs",
  "types": "./dist/device.d.ts",
  "exports": {
    ".": {
      "types": "./dist/device.d.ts",
      "import": "./dist/device.mjs",
      "require": "./dist/device.js",
      "default": "./dist/device.mjs"
    },
    "./dist/device.js": "./dist/device.js",
    "./dist/device.es.js": "./dist/device.es.js",
    "./dist/device.mjs": "./dist/device.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "author": "skillnull",
  "keywords": [
    "DeviceJS",
    "Device",
    "device-js",
    "skillnull",
    "SKILL.NULL"
  ],
  "scripts": {
    "build": "npm run clean && rollup --config rollup.config.js --bundleConfigAsCjs && npm run build:types",
    "build:types": "tsc --project tsconfig.json --emitDeclarationOnly",
    "clean": "rm -rf dist",
    "test": "npm run build && node --test test/*.test.cjs scripts/*.test.mjs",
    "check": "npm test && npm pack --dry-run",
    "publish": "node scripts/publish-device.mjs"
  },
  "homepage": "https://github.com/skillnull/DeviceJs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skillnull/DeviceJs.git"
  },
  "bugs": {
    "url": "https://github.com/skillnull/DeviceJs/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.24.7",
    "@babel/plugin-transform-runtime": "^7.24.7",
    "@babel/preset-env": "^7.24.7",
    "@babel/runtime": "^7.24.7",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.1.4",
    "rollup": "^4.18.0",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3"
  },
  "browserslist": [
    "iOS >= 10",
    "Android >= 4.4",
    "last 2 versions"
  ],
  "overrides": {
    "baseline-browser-mapping": "^2.11.34",
    "browserslist": "^4.29.5"
  }
}
